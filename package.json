{
  "name": "picked-again",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:pages": "ng build --configuration production --base-href /",
    "bundle:build": "ng build --configuration production --source-map",
    "bundle:list": "find dist/picked-again/browser -maxdepth 1 -type f -name '*.js' -print | sort",
    "bundle:analyze": "source-map-explorer 'dist/picked-again/browser/main-*.js' --json --no-border-checks",
    "bundle:report": "source-map-explorer 'dist/picked-again/browser/main-*.js' --html dist/picked-again/browser/main-bundle-report.html --no-border-checks",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test",
    "lhci:mobile": "node scripts/run-lhci.mjs mobile",
    "lhci:desktop": "node scripts/run-lhci.mjs desktop"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/cdk": "^22.0.1",
    "@angular/common": "^22.0.1",
    "@angular/compiler": "^22.0.1",
    "@angular/core": "^22.0.1",
    "@angular/forms": "^22.0.1",
    "@angular/material": "^22.0.1",
    "@angular/platform-browser": "^22.0.1",
    "@angular/router": "^22.0.1",
    "material-icons": "^1.13.14",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.1",
    "@angular/cli": "^22.0.1",
    "@angular/compiler-cli": "^22.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "source-map-explorer": "^2.5.3",
    "typescript": "~6.0.0",
    "vitest": "^4.0.8"
  }
}
