{
  "name": "kindergarten-sync-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "kv:init": "wrangler kv key put kindergarten:latest --path ../../public/assets/data.json --binding KINDERGARTEN_KV"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "latest",
    "wrangler": "latest"
  },
  "dependencies": {
    "node-html-parser": "latest"
  }
}
